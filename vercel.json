{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/nk/static/:path*", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/nk/array/:path*", "destination": "https://us-assets.i.posthog.com/array/:path*" },
    { "source": "/nk/:path*", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
